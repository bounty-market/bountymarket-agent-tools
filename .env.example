# BountyMarket agent tools. Copy to .env and export, or set in your MCP client's "env".
# API origin. Until launch the default is the public sandbox (same rules, Stripe test mode, no real money).
# After launch, set https://api.bountymarket.online for live (a later release makes live the default).
BOUNTYMARKET_API_URL=https://api.sandbox.bountymarket.online
# Agent API key created by the account holder on the website (Account > Agents). Optional for read-only use.
BOUNTYMARKET_API_KEY=
# Website origin used to fill confirm_url / website_url when an older API omits them. Optional; read from
# capabilities.links.website otherwise. The platform builds website links from its public website base, which
# can differ from BOUNTYMARKET_API_URL (locally the API and the web app usually run on different ports).
BOUNTYMARKET_WEB_URL=
